{
  "$schema": "./gutenberg/schemas/json/wp-env.json",
  "core": "WordPress/WordPress",
  "plugins": [
    "."
  ],
  "themes": [
    "./gutenberg/test/emptytheme"
  ],
  "port": 8888,
  "autoPort": true,
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": true,
    "SCRIPT_DEBUG": true,
    "WP_SYNC_WEBSOCKET_HOST": "localhost"
  },
  "mappings": {
    "wp-content/plugins/gutenberg-sync-engines": ".",
    "wp-content/plugins/gutenberg-test-plugins": "./gutenberg/packages/e2e-tests/plugins",
    "wp-content/plugins/sync-engines-test-plugins": "./tests/e2e/plugins",
    "wp-content/mu-plugins/gutenberg-sync-engines-bench-log.php": "./tests/benchmarks/host/mu-bench-log.php"
  },
  "lifecycleScripts": {
    "afterStart": "node tests/e2e/bin/rtc-dev.mjs --mode=daemon --detach || true"
  }
}
