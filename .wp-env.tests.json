{
  "$schema": "./gutenberg/schemas/json/wp-env.json",
  "core": "WordPress/WordPress",
  "plugins": [ "." ],
  "themes": [ "./gutenberg/test/emptytheme" ],
  "port": 8889,
  "autoPort": true,
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": false,
    "SCRIPT_DEBUG": false,
    "WP_SYNC_SSE_REDIS_URL": "redis://sync-redis:6379",
    "WP_SYNC_WEBSOCKET_HOST": "localhost"
  },
  "lifecycleScripts": {
    "afterStart": "GSE_WP_ENV_CONFIG=.wp-env.tests.json npm run redis:start || echo 'Redis did not start: the SSE transport runs on polling until it does (npm run doctor)'",
    "afterDestroy": "GSE_WP_ENV_CONFIG=.wp-env.tests.json npm run redis:destroy"
  },
  "mappings": {
    "wp-content/plugins/gutenberg-sync-engines": ".",
    "wp-content/plugins/gutenberg": "./tests/e2e/plugins/gutenberg-stub",
    "wp-content/plugins/gutenberg-test-plugins": "./gutenberg/packages/e2e-tests/plugins",
    "wp-content/plugins/sync-engines-test-plugins": "./tests/e2e/plugins",
    "wp-content/mu-plugins/gutenberg-sync-engines-bench-log.php": "./tests/benchmarks/host/mu-bench-log.php"
  }
}
