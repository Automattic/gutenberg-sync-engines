{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@wordpress/block-editor": [
        "./gutenberg/node_modules/@wordpress/block-editor/build-types"
      ],
      "@wordpress/editor": [
        "./gutenberg/node_modules/@wordpress/editor/build-types"
      ],
      "@wordpress/*": [
        "./gutenberg/node_modules/@wordpress/*"
      ]
    },
    "preserveSymlinks": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "@wordpress/element"
    ]
  },
  "include": [
    "src/**/*",
    "tests/js/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    // The Jest specs drive the intent-log core with loose fixtures on
    // purpose. The core itself (src/engines/intent-log/*.js) and the
    // Node-only harness modules beside the specs (simulator,
    // genesis-sync-id) ARE checked, via checkJs and their JSDoc.
    "tests/js/**/*.test.js",
    "tests/js/jest-setup*.js",
    // The suites that came over from Gutenberg's core-data and editor
    // packages were written under their looser TypeScript config (Jest
    // globals, untyped mocks). Jest runs them; the type check skips them.
    "tests/js/awareness/typed/**",
    "tests/js/engines/yjs/crdt/**",
    "tests/js/ui/**"
  ]
}
