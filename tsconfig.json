{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@wordpress/sync": [
				"../workspaces/gutenberg/try-intent-log/packages/sync/src"
			],
			"yjs": [
				"../workspaces/gutenberg/try-intent-log/node_modules/yjs"
			],
			"y-protocols/*": [
				"../workspaces/gutenberg/try-intent-log/node_modules/y-protocols/*"
			],
			"lib0/*": [
				"../workspaces/gutenberg/try-intent-log/node_modules/lib0/*"
			]
		},
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": false,
		"types": [ "@wordpress/element" ]
	},
	"include": [ "src/**/*", "tests/js/**/*" ],
	"exclude": [ "node_modules", "build", "src/engines/intent-log/*.js" ]
}
